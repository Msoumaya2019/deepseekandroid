<?xml version="1.0" encoding="utf-8"?>
<!--
  Point d'entree de l'application.

  Deux points meritent une justification :

  - `allowBackup="true"` avec des regles d'exclusion. La progression d'apprentissage represente
    des mois de travail : la perdre en changeant d'appareil serait la pire regression possible.
    En revanche le jeton de session est **chiffre par une cle qui vit dans le magasin de cles du
    systeme**, et cette cle ne suit pas une sauvegarde. Le restaurer sur un autre appareil
    produirait un fichier indechiffrable — sans danger, mais inutile. Il est donc exclu.

  - `android:configChanges` inclut `uiMode` et `screenSize`. Sans cela, un changement de theme
    systeme ou un passage en ecran partage reconstruirait l'activite : le lecteur de moushaf
    reviendrait a la premiere page au lieu de rester ou l'utilisateur en etait.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Synchronisation de l'etat avec Supabase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detection de la connectivite : l'application doit dire « hors connexion » plutot que
         d'echouer silencieusement. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rappel de 19 h et notifications de messages. Demandee a partir d'Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lecture ecran eteint. Android n'autorise un lecteur a continuer qu'au travers d'un
         service d'avant-plan ; ces deux permissions sont ce qui permet de l'elever. La premiere
         existe depuis Android 8, la seconde est obligatoire a partir d'Android 14 et doit citer
         le type `mediaPlayback`. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".DeepSeekApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepSeekAndroid"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          La lecture audible ecran eteint.

          `exported="true"` est exige : c'est le systeme, et non l'application, qui lie ce
          service pour l'ecran verrouille et les ecouteurs Bluetooth. Le filtrer rendrait la
          notification inoperante.

          `foregroundServiceType="mediaPlayback"` dit a Android ce que le service fait, et
          conditionne l'autorisation de tourner en avant-plan sur les versions recentes. Le
          service herite de `MediaSessionService`, qui eleve et abaisse lui-meme l'avant-plan
          selon que la lecture est en cours ou arretee : rien a gerer a la main.
        -->
        <service
            android:name="com.msoumaya.deepseekandroid.core.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
