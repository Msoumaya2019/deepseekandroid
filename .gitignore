# --- Gradle / Android Studio -----------------------------------------------
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.iml
.idea/
local.properties

# --- Artefacts de build ----------------------------------------------------
*.apk
*.aab
*.ap_
*.dex
output.json

# --- Secrets : jamais dans le dépôt ----------------------------------------
# Clé de signature, keystore, configuration Firebase, et toute copie locale de
# `local.properties` (qui porte l'URL Supabase et la clé publishable).
*.jks
*.keystore
*.p12
*.pem
*.cer
*.mobileprovision
google-services.json
secrets.properties

# --- Ressources coraniques importées ---------------------------------------
# `tools/import-quran-assets.mjs` copie les pages du moushaf depuis une copie locale
# de `coran-memoire`. Les images sont volumineuses (118,2 Mo mesurés pour les 604 pages
# du Coran de Médine, soit 118 203 707 octets). Elles sont versionnées uniquement si le
# propriétaire du dépôt le décide explicitement : voir README.md, section « Ressources
# coraniques ».
#
# Pour les exclure du dépôt, décommenter les deux lignes suivantes :
# app/src/main/assets/quran/pages/
# app/src/main/assets/quran/tajweed/

# --- Divers -----------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.kotlin/

# --- Outils Python ----------------------------------------------------------
# `tools/` porte sept outils Python ; les lancer — ou seulement les importer —
# laisse un cache `__pycache__/` a cote des sources. Il n'a rien a faire dans le
# depot, et l'exclure ici evite d'avoir a s'en souvenir a chaque `git add`.
__pycache__/
*.pyc
